# Copy to .env.local and fill in your Supabase project's values (Project Settings → API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional. Set to true once the Supabase "Magic Link" and "Confirm signup" email templates include {{ .Token }}
# (editing templates needs custom SMTP). Turns on 6-digit email-code sign-in, which the installed app (PWA) needs
# because email links open in the browser, not the app. Leave unset to sign in with a password in the installed app.
# VITE_AUTH_EMAIL_CODES=true
